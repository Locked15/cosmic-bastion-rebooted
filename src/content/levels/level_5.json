            "flag": "archive_saved"
        }
    ],
    "events": [
        {
            "wave": 0,
            "trigger": "start",
            "dialog": {
                "kind": "unknown",
                "title": "КАПИТАН-НОСИТЕЛЬ ИРЕНА ВОСС",
                "text": "Средоточие у реактора. Это самое тяжёлое, что есть на световые годы вокруг, и Сонм хочет его. Судьба корабля решится здесь.",
                "choices": [
                    {
                        "text": "Стража на позициях",
                        "effect": null,
                        "consequence": "Стража заняла позиции."
                    }
                ],
                "timed": false
            }
        },
        {
            "wave": 1,
            "trigger": "start",
            "dialog": {
                "kind": "full",
                "title": "РАСПРЕДЕЛЕНИЕ ЭНЕРГИИ",
                "text": "Реактор отдаёт всё, что у него есть. Куда направить мощность?",
                "choices": [
                    {
                        "text": "Энергия в оружие",
                        "effect": { "type": "resources", "value": 250 },
                        "consequence": "Получено 250 ресурсов."
                    },
                    {
                        "text": "Энергия в щиты",
                        "effect": { "type": "buffBarricades", "value": 1.6 },
                        "consequence": "Прочность всех баррикад увеличена на 60%."
                    }
                ],
                "timed": true,
                "timeLimit": 15
            }
        },
        {
            "wave": 2,
            "trigger": "delay",
            "delay": 120,
            "dialog": {
                "kind": "partial",
                "title": "КРИТИЧЕСКИЙ МОМЕНТ",
                "text": "Средоточие учится быстрее, чем мы перестраиваемся. Нужно действовать.",
                "choices": [
                    {
                        "text": "Активировать резервы",
                        "effect": { "type": "emergency", "resources": 200, "military": 6 },
                        "consequence": "Получено 200 ресурсов и 6 военных."
                    },
                    {
                        "text": "Перегрузить башни",
                        "effect": { "type": "buffDamage", "value": 1.7 },
                        "consequence": "Урон башен увеличен на 70%."
                    }
                ],
                "timed": true,
                "timeLimit": 7
            }
        },
        {
            "wave": 2,
            "trigger": "start",
            "dialog": {
                "kind": "partial",
                "title": "ГОЛОС АРХИВА",
                "text": "«Вес — это верность. Останьтесь.» Архив предлагает открыть аварийные резервы реактора.",
                "choices": [
                    {
                        "text": "Принять резервы",
                        "consequence": "Архив открыл резервы. Получено 150 ресурсов. Ему нужен реактор целым.",
                        "effect": { "type": "resources", "value": 150 }
                    },
                    {
                        "text": "Заглушить канал",
                        "consequence": "Канал заглушён. Архив замолчал.",
                        "effect": null
                    }
                ],
                "timed": true,
                "timeLimit": 10
            },
            "when": [{ "flag": "archive_silenced", "below": 1 }]
        },
        {
            "wave": 3,
            "trigger": "delay",
            "delay": 60,
            "dialog": {
                "kind": "full",
                "title": "СУДНО-СВИДЕТЕЛЬ «БЕЗМОЛВИЕ»",
                "text": "«Безмолвие» на высокой орбите. Принимает архив и координаты выживших. Посадку не обещает.",
                "choices": [
                    {
                        "text": "Передать архив",
                        "effect": { "type": "flag", "name": "archive_saved", "value": 1 },
                        "consequence": "Архив передан. Правда уйдёт к Синоду, даже если реактор падёт.",
                        "cost": { "resources": 100 }
                    },
                    {
                        "text": "Оставить архив на корабле",
                        "effect": null,
                        "consequence": "Решение принято. Состояние сектора не изменилось."
                    }
                ],
                "timed": true,
                "timeLimit": 10
            }
        },
        {
            "wave": 3,
            "trigger": "start",
            "when": [{ "flag": "relic_secured", "below": 1 }],
            "dialog": {
                "kind": "full",
                "title": "КОПЬЁ «ОТРЕЧЕНИЕ»",
                "text": "Реакторное копьё «Отречение» можно запустить. Оно выпивает свой расчёт досуха.",
                "choices": [
                    {
                        "text": "Запустить копьё",
                        "consequence": "7 военных отданы расчёту. Уничтожено 60% активных врагов.",
                        "effect": { "type": "superWeapon", "military": -7, "killPercent": 0.6 }
                    },
                    {
                        "text": "Сражаться обычными силами",
                        "consequence": "Решение принято. Состояние сектора не изменилось.",
                        "effect": null
                    }
                ],
                "timed": true,
                "timeLimit": 10
            }
        },
        {
            "wave": 3,
            "trigger": "start",
            "when": [{ "flag": "relic_secured", "atLeast": 1 }],
            "dialog": {
                "kind": "full",
                "title": "КОПЬЁ «ОТРЕЧЕНИЕ»",
                "text": "Копьё из Ризницы подключено к реактору. Расчёт подготовлен заранее.",
                "choices": [
                    {
                        "text": "Запустить копьё",
                        "consequence": "4 военных отданы расчёту. Уничтожено 80% активных врагов.",
                        "effect": { "type": "superWeapon", "military": -4, "killPercent": 0.8 }
                    },
                    {
                        "text": "Сражаться обычными силами",
                        "consequence": "Решение принято. Состояние сектора не изменилось.",
                        "effect": null
                    }
                ],
                "timed": true,
                "timeLimit": 10
            }
        },
        {
            "wave": 4,
            "trigger": "start",
            "dialog": {
                "kind": "full",
                "title": "ФИНАЛЬНАЯ АТАКА",
                "text": "Всё или ничего. Последний резерв доступен.",
                "choices": [
                    {
                        "text": "Задействовать резерв",
                        "effect": { "type": "resources", "value": 300 },
                        "consequence": "Получено 300 ресурсов."
                    },
                    {
                        "text": "Сохранить силы",
                        "effect": null,
                        "consequence": "Решение принято. Состояние сектора не изменилось."
                    }
                ],
                "timed": true,
                "timeLimit": 15
            }
        },
        {
            "wave": 5,
            "trigger": "start",
            "when": [
                { "flag": "scientist_saved", "atLeast": 1 },
                { "flag": "relic_secured", "atLeast": 1 },
                { "flag": "archive_saved", "atLeast": 1 }
            ],
            "dialog": {
                "kind": "full",
                "title": "РАСЧЁТ СИЛЬВЫ",
                "text": "Сильва: «Если направить „Отречение“ сквозь реактор — в сердце Колодца, Тризна разучится держаться вместе. Корабль уйдёт вместе с ней».",
                "choices": [
                    {
                        "text": "Направить копьё в Колодец",
                        "consequence": "Копьё перенацелено. Пути назад нет.",
                        "effect": { "type": "flag", "name": "ending_renunciation", "value": 1 }
                    },
                    {
                        "text": "Нет. Мы будем жить",
                        "consequence": "Копьё осталось на прежнем прицеле.",
                        "effect": null
                    }
                ],
                "timed": true,
                "timeLimit": 15
            }
        }
