    "events": [
        {
            "wave": 0,
            "trigger": "start",
            "dialog": {
                "kind": "unknown",
                "title": "КАПИТАН-НОСИТЕЛЬ ИРЕНА ВОСС",
                "text": "Балластные цистерны К-8. Девять тысяч тонн освящённого свинца — вес, который Синод вложил в каждый Бастион как молитву.",
                "choices": [
                    {
                        "text": "Стража на позициях",
                        "consequence": "Стража заняла галереи над цистернами.",
                        "effect": null
                    }
                ],
                "timed": false
            }
        },
        {
            "wave": 1,
            "trigger": "delay",
            "delay": 180,
            "when": [{ "flag": "engineer_saved", "atLeast": 1 }],
            "dialog": {
                "kind": "full",
                "title": "СТАРШИЙ ИНЖЕНЕР ЧЕН ЛО",
                "text": "«Двигатели не поднимут нас со свинцом в брюхе. Сбросить придётся либо балласт, либо жилой слой».",
                "choices": [
                    {
                        "text": "Принять к сведению",
                        "consequence": "Решение придётся принять до реактора.",
                        "effect": null
                    }
                ],
                "timed": false
            }
        },
        {
            "wave": 1,
            "trigger": "delay",
            "delay": 180,
            "when": [{ "flag": "engineer_saved", "below": 1 }],
            "dialog": {
                "kind": "full",
                "title": "РАСЧЁТ ТЯГИ",
                "text": "Без Чена тягу считают по старым таблицам: со святым балластом корабль не взлетит ни при каких двигателях.",
                "choices": [
                    {
                        "text": "Принять к сведению",
                        "consequence": "Решение придётся принять до реактора.",
                        "effect": null
                    }
                ],
                "timed": false
            }
        },
        {
            "wave": 2,
            "trigger": "start",
            "when": [{ "flag": "cult_spared", "atLeast": 1 }],
            "dialog": {
                "kind": "partial",
                "title": "СТАРШИЙ НОСИТЕЛЬ ТАДЕУШ МОР",
                "text": "Мор приводит Причастников к клапанам: «Сбросить святой вес — значит отречься от Обета».",
                "choices": [
                    {
                        "text": "Оттеснить Причастников",
                        "cost": { "military": 2 },
                        "consequence": "Клапаны свободны. Двое стражников ранены.",
                        "effect": null
                    },
                    {
                        "text": "Уступить клапаны",
                        "consequence": "Причастники молятся у клапанов. Решение всё равно за вами.",
                        "effect": null
                    }
                ],
                "timed": true,
                "timeLimit": 12
            }
        },
