                    {
                        "text": "Стража на позициях",
                        "consequence": "Стража заняла нефы.",
                        "effect": null
                    }
                ],
                "timed": false
            }
        },
        {
            "wave": 1,
            "trigger": "start",
            "dialog": {
                "kind": "full",
                "title": "ДВА НЕФА",
                "text": "У Ризницы два прохода. Если перекрыть главный неф, пыль пойдёт боковым.",
                "choices": [
                    {
                        "text": "Укрепить баррикады",
                        "consequence": "Прочность баррикад увеличена на 30%.",
                        "effect": { "type": "buffBarricades", "value": 1.3 }
                    },
                    {
                        "text": "Вскрыть оружейные ящики",
                        "consequence": "Получено 120 ресурсов.",
                        "effect": { "type": "resources", "value": 120 }
                    }
                ],
                "timed": true,
                "timeLimit": 12
            }
        },
        {
            "id": "relic_lance",
            "wave": 2,
            "trigger": "delay",
            "delay": 180,
            "dialog": {
                "kind": "partial",
                "title": "КОПЬЁ «ОТРЕЧЕНИЕ»",
                "text": "В центральном ковчеге — гравитационное копьё. Оно «развешивает» материю вокруг себя и выпивает свой расчёт досуха.",
                "choices": [
                    {
                        "text": "Вынести копьё",
                        "cost": { "resources": 120 },
                        "consequence": "Копьё вынесено. В реакторном секторе его удар будет сильнее и дешевле. Потрачено 120 ресурсов.",
                        "effect": { "type": "flag", "name": "relic_secured", "value": 1 }
                    },
                    {
                        "text": "Не трогать реликвию",
                        "consequence": "Копьё осталось в ковчеге.",
                        "effect": null
                    }
                ],
                "timed": true,
                "timeLimit": 12
            }
        },
        {
            "wave": 3,
            "trigger": "start",
            "when": [{ "flag": "scientist_saved", "atLeast": 1 }],
            "dialog": {
                "kind": "full",
                "title": "ДОКТОР МИРЕЯ СИЛЬВА",
                "text": "Сонм держится на заряде. Реликварные катушки можно перенастроить на разряд.",
                "choices": [
                    {
                        "text": "Перенастроить катушки",
                        "cost": { "resources": 100 },
                        "consequence": "Электрошоковая установка открыта для следующих миссий раньше срока. Потрачено 100 ресурсов.",
                        "effect": { "type": "unlockTower", "tower": "shock" }
                    },
                    {
                        "text": "Не тратить время",
                        "consequence": "Решение принято. Состояние сектора не изменилось.",
                        "effect": null
                    }
                ],
                "timed": true,
                "timeLimit": 12
            }
        },
