                    {
                        "text": "Отправить образцы в лабораторию",
                        "cost": { "resources": 40 },
                        "consequence": "Образцы ушли к Сильве. Потрачено 40 ресурсов.",
                        "effect": { "type": "flag", "name": "ore_samples", "value": 1 }
                    },
                    {
                        "text": "Копать дальше",
                        "consequence": "Добыча продолжается. Получено 120 ресурсов.",
                        "effect": { "type": "resources", "value": 120 }
                    }
                ],
                "timed": true,
                "timeLimit": 12
            }
        },
        {
            "wave": 2,
            "trigger": "start",
            "dialog": {
                "kind": "full",
                "title": "ДОЛГ В КИЛОГРАММАХ",
                "text": "Горбань: «Каждый спуск списывает с нас сорок килограммов долга. Сегодня спустились все».",
                "choices": [
                    {
                        "text": "Списать долг смены",
                        "cost": { "resources": 60 },
                        "consequence": "Долг смены списан. Тягло это запомнит. Потрачено 60 ресурсов.",
                        "effect": {
                            "type": "transaction",
                            "cost": {},
                            "effects": [
                                { "type": "flag", "name": "debt_forgiven", "value": 1 },
                                { "type": "relationship", "character": "gorban", "disposition": 2 }
                            ]
                        }
                    },
                    {
                        "text": "Устав есть устав",
                        "consequence": "Смена отработала долг. Получено 80 ресурсов.",
                        "effect": {
                            "type": "transaction",
                            "cost": {},
                            "effects": [
                                { "type": "resources", "value": 80 },
                                { "type": "relationship", "character": "gorban", "disposition": -2 }
                            ]
                        }
                    }
                ],
                "timed": true,
                "timeLimit": 12
            }
        },
