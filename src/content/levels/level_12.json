        },
        {
            "wave": 1,
            "trigger": "delay",
            "delay": 120,
            "dialog": {
                "kind": "partial",
                "title": "ПРИЧАСТНИКИ",
                "text": "Носители открывают внутренние шлюзы часовни и поют. Пыль идёт на голос.",
                "choices": [
                    {
                        "text": "Закрыть шлюзы силой",
                        "cost": { "military": 2 },
                        "consequence": "Шлюзы закрыты, двое стражников ранены. Прочность баррикад увеличена на 20%.",
                        "effect": { "type": "buffBarricades", "value": 1.2 }
                    },
                    {
                        "text": "Не вмешиваться",
                        "consequence": "Шлюзы остались открытыми.",
                        "effect": null
                    }
                ],
                "timed": true,
                "timeLimit": 12
            }
        },
        {
            "wave": 2,
            "trigger": "start",
            "when": [{ "flag": "scientist_saved", "atLeast": 1 }],
            "dialog": {
                "kind": "full",
                "title": "ДОКТОР МИРЕЯ СИЛЬВА",
                "text": "Их литания совпадает с частотой, на которой Архив звал «Неусыпного». Это не молитва. Это позывной.",
                "choices": [
                    {
                        "text": "Заглушить частоту",
                        "cost": { "resources": 80 },
                        "consequence": "Частота заглушена. Потрачено 80 ресурсов.",
                        "effect": { "type": "flag", "name": "litany_jammed", "value": 1 }
                    },
                    {
                        "text": "Оставить",
                        "consequence": "Решение принято. Состояние сектора не изменилось.",
                        "effect": null
                    }
                ],
                "timed": true,
                "timeLimit": 12
            }
        },
        {
            "wave": 3,
            "trigger": "start",
            "dialog": {
                "kind": "full",
                "title": "ЛИСТ ВНУТРЕННЕГО КРУГА",
                "text": "У Мора нашли лист с печатью Внутреннего Круга: список Бастионов с суффиксом «КП».",
                "choices": [
                    {
                        "text": "Передать лист капитану",
                        "consequence": "Восс получила лист. Правда дошла до неё раньше двигательного отсека.",
                        "effect": {
                            "type": "transaction",
                            "cost": {},
                            "effects": [
                                { "type": "flag", "name": "truth_told", "value": 1 },
                                { "type": "relationship", "character": "voss", "disposition": 1 }
                            ]
                        }
                    },
                    {
                        "text": "Сжечь лист",
                        "consequence": "Лист сгорел. Мор улыбнулся.",
                        "effect": null
                    }
                ],
                "timed": true,
                "timeLimit": 12
            }
        },
