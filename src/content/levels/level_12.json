    "events": [
        {
            "wave": 0,
            "trigger": "start",
            "dialog": {
                "kind": "unknown",
                "title": "СТАРШИЙ НОСИТЕЛЬ ТАДЕУШ МОР",
                "text": "«Часовня Груза открыта для молитвы. Вес — это верность. Пусть пыль войдёт: она тоже несёт вес».",
