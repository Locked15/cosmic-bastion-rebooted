    "events": [
        {
            "wave": 0,
            "trigger": "start",
            "dialog": {
                "kind": "unknown",
                "title": "КАПИТАН-НОСИТЕЛЬ ИРЕНА ВОСС",
                "text": "Мостик S-1 отрезан с первых часов. Пульты мертвы, кресло пустует. Корабль, которым никто не командует, — уже обломок.",
                "choices": [
                    {
                        "text": "Вернуть мостик",
                        "consequence": "Стража пошла на мостик.",
                        "effect": null
                    }
                ],
                "timed": false
            }
        },
        {
            "wave": 1,
            "trigger": "delay",
            "delay": 180,
            "dialog": {
                "kind": "full",
                "title": "РЕГИСТРОВАЯ ПЛИТА",
                "text": "На переборке — плита с регистром корабля: «СТ-БЛК·IV-0417 «ТО» / У-12 / 91,4 Мт / КП-41». Суффикс «КП» не значится ни в одном уставе.",
                "choices": [
                    {
                        "text": "Переписать регистр",
                        "consequence": "Регистр переписан. Инженеры не знают, что значит «КП-41».",
                        "effect": { "type": "flag", "name": "registry_seen", "value": 1 }
                    },
                    {
                        "text": "Не тратить время",
                        "consequence": "Решение принято. Состояние сектора не изменилось.",
                        "effect": null
                    }
                ],
                "timed": true,
                "timeLimit": 12
            }
        },
        {
            "wave": 1,
            "trigger": "delay",
            "delay": 300,
            "when": [{ "flag": "wreck_found", "atLeast": 1 }],
            "dialog": {
                "kind": "partial",
                "title": "ОБШИВКА «НЕУСЫПНОГО»",
                "text": "На обшивке из ангара тот же суффикс: «КП-38». Два Бастиона, один удел, одна метка.",
                "choices": [
                    {
                        "text": "Сопоставить метки",
                        "consequence": "Совпадение занесено в журнал. Это не плановая проверка.",
                        "effect": { "type": "flag", "name": "kp_pattern", "value": 1 }
                    },
                    {
                        "text": "Списать на совпадение",
                        "consequence": "Восс промолчала.",
                        "effect": null
                    }
                ],
                "timed": true,
                "timeLimit": 12
            }
        },
        {
            "wave": 2,
            "trigger": "start",
            "dialog": {
                "kind": "full",
                "title": "ЛЕЙТЕНАНТ ОДА КИРХ",
                "text": "Пыль лезет через вентиляцию пультов. Перекрыть шахты или выжечь их?",
                "choices": [
                    {
                        "text": "Перекрыть вентиляцию",
                        "consequence": "Прочность баррикад увеличена на 30%.",
                        "effect": { "type": "buffBarricades", "value": 1.3 }
                    },
                    {
                        "text": "Выжечь шахты",
                        "consequence": "Урон башен увеличен на 30%.",
                        "effect": { "type": "buffDamage", "value": 1.3 }
                    }
                ],
                "timed": true,
                "timeLimit": 12
            }
        },
        {
            "id": "command_codes",
            "wave": 3,
            "trigger": "delay",
            "delay": 120,
            "dialog": {
                "kind": "full",
                "title": "КОМАНДНЫЕ КОДЫ",
                "text": "Пульты оживают. Восс может принять командование вручную — или доверить мостик Архиву, как велит устав.",
                "choices": [
                    {
                        "text": "Ручное командование",
                        "cost": { "resources": 80 },
                        "consequence": "Восс заняла кресло. Мостик под ручным управлением, коды доступа к Архивному ядру у капитана. Потрачено 80 ресурсов.",
                        "effect": {
                            "type": "transaction",
                            "cost": {},
                            "effects": [
                                { "type": "flag", "name": "bridge_retaken", "value": 1 },
                                { "type": "flag", "name": "bridge_manual", "value": 1 }
                            ]
                        }
                    },
                    {
                        "text": "Доверить мостик Архиву",
                        "consequence": "Архив принял мостик: «Обет благодарит». Открыты резервы — получено 120 ресурсов.",
                        "effect": {
                            "type": "transaction",
                            "cost": {},
                            "effects": [
                                { "type": "flag", "name": "bridge_retaken", "value": 1 },
                                { "type": "flag", "name": "bridge_archive", "value": 1 },
                                { "type": "resources", "value": 120 }
                            ]
                        }
                    }
                ],
                "timed": true,
                "timeLimit": 15
            }
        },
        {
            "wave": 4,
            "trigger": "start",
            "dialog": {
                "kind": "unknown",
                "title": "ГОЛОС АРХИВА",
                "text": "«Кресло капитана тяжелее, чем кажется. Сядьте в него — и вы поймёте Обет».",
                "choices": [
                    {
                        "text": "Отключить динамики",
                        "consequence": "Динамики отключены.",
                        "effect": null
                    }
                ],
                "timed": false
            }
        },
        {
            "wave": 5,
            "trigger": "start",
            "dialog": {
                "kind": "full",
                "title": "ПОСЛЕДНЯЯ ВОЛНА У МОСТИКА",
                "text": "Сонм бросает на мостик всё, что у него есть.",
                "choices": [
                    {
                        "text": "Поднять Стражу",
                        "consequence": "Прибыли 4 военных.",
                        "effect": { "type": "addMilitary", "count": 4 }
                    },
                    {
                        "text": "Вскрыть сейф капитана",
                        "consequence": "Получено 180 ресурсов. Восс отвернулась.",
                        "effect": { "type": "resources", "value": 180 }
                    }
                ],
                "timed": true,
                "timeLimit": 12
